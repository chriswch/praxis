{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/recovery.schema.json",
  "title": "Praxis Durable Recovery Marker",
  "description": "Fail-closed recovery marker for an in-flight multi-file durable transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "operation",
    "transaction_id",
    "transaction_dir",
    "started_at",
    "metadata",
    "files"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "const": "pending"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_dir": {
      "type": "string",
      "pattern": "^\\.praxis/transactions/.+$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_path",
          "staged_path",
          "sha256"
        ],
        "properties": {
          "target_path": {
            "type": "string",
            "pattern": "^\\.praxis(?:/.*)?$"
          },
          "staged_path": {
            "type": "string",
            "pattern": "^\\.praxis/transactions/.+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
