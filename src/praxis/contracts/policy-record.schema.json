{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/policy-record.schema.json",
  "title": "Praxis Policy Record",
  "description": "Durable record of a machine-side policy or gate outcome stored under .praxis/runtime/policies/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recorded_at",
    "run_id",
    "workflow",
    "scope",
    "slice_id",
    "artifact_dir",
    "stage",
    "worker_id",
    "worker_class",
    "permission_profile",
    "worktree_mode",
    "dispatch_id",
    "dispatch_record_path",
    "context_manifest_path",
    "gate_type",
    "configured_value",
    "decision",
    "source",
    "reason_code",
    "reason"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "slice_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_dir": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["interactive_orchestrator", "session_worker", "worktree_worker", "subagent_worker"]
        },
        {
          "type": "null"
        }
      ]
    },
    "permission_profile": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["planning", "design", "implementation", "review", "verification"]
        },
        {
          "type": "null"
        }
      ]
    },
    "worktree_mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["shared", "isolated"]
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch_record_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_manifest_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_type": {
      "type": "string",
      "enum": ["filesystem", "network", "destructive_command", "story_boundary"]
    },
    "configured_value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "type": "string",
      "enum": ["allowed", "denied"]
    },
    "source": {
      "type": "string",
      "enum": ["dispatch_compiler", "story_boundary"]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
