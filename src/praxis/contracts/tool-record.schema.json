{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/tool-record.schema.json",
  "title": "Praxis Tool Record",
  "description": "Durable record of one brokered tool invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recorded_at",
    "run_id",
    "dispatch_id",
    "adapter",
    "workflow",
    "scope",
    "slice_id",
    "artifact_dir",
    "stage",
    "worker",
    "tool",
    "policy",
    "request",
    "outcome",
    "response"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "enum": ["claude", "codex"]},
    "workflow": {"type": "string", "enum": ["craft", "forge"]},
    "scope": {"type": "string", "enum": ["root", "feature", "slice"]},
    "slice_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "artifact_dir": {"type": "string", "pattern": "^\\.praxis(?:/.*)?$"},
    "stage": {"type": "string", "minLength": 1},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "worker_class", "session_id", "dispatch_record_path", "worker_record_path"],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "worker_class": {"type": "string", "enum": ["interactive_orchestrator", "session_worker", "worktree_worker", "subagent_worker"]},
        "session_id": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "dispatch_record_path": {"type": "string", "pattern": "^\\.praxis(?:/.*)?$"},
        "worker_record_path": {"type": "string", "pattern": "^\\.praxis(?:/.*)?$"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "description", "permission_class", "side_effect_class", "latency_class", "provenance", "native_surface", "broker_action"],
      "properties": {
        "tool_id": {"type": "string", "enum": ["repo_read", "repo_search", "repo_patch", "repo_shell", "network_fetch"]},
        "description": {"type": "string", "minLength": 1},
        "permission_class": {"type": "string", "enum": ["read_only", "workspace_write", "network_access"]},
        "side_effect_class": {"type": "string", "enum": ["none", "filesystem_write", "network"]},
        "latency_class": {"type": "string", "enum": ["low", "medium", "high"]},
        "provenance": {"type": "string", "const": "praxis_runtime"},
        "native_surface": {"type": "string", "minLength": 1},
        "broker_action": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "filesystem_scope", "network_access", "destructive_commands_allowed", "enforcement_mode", "control_plane_access", "writable_roots", "blocked_paths"],
      "properties": {
        "profile": {"type": "string", "enum": ["planning", "design", "implementation", "review", "verification"]},
        "filesystem_scope": {"type": "string", "enum": ["workspace-write", "read-only", "danger-full-access", "inherit"]},
        "network_access": {"type": "string", "enum": ["restricted", "enabled", "inherit"]},
        "destructive_commands_allowed": {"type": "boolean"},
        "enforcement_mode": {"type": "string", "enum": ["enforced", "advisory"]},
        "control_plane_access": {"type": "string", "enum": ["direct_repo", "projected_read_only"]},
        "writable_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "blocked_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["completed", "denied", "failed"]},
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
