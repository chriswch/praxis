{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/approval-record.schema.json",
  "title": "Praxis Approval Record",
  "description": "Durable record of a user approval or denial stored under .praxis/runtime/approvals/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recorded_at",
    "run_id",
    "decision",
    "source",
    "reason_code",
    "reason",
    "workflow",
    "scope",
    "slice_id",
    "artifact_dir",
    "stage",
    "worker_id",
    "session_id",
    "next_action",
    "next_stage",
    "next_slice_id",
    "boundary_handoff_path",
    "dispatch_id",
    "dispatch_record_path"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["approved", "denied"]
    },
    "source": {
      "type": "string",
      "enum": ["continue", "approve", "cancel"]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_dir": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "next_stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "next_slice_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "boundary_handoff_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "dispatch_record_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
