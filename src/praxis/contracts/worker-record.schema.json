{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/worker-record.schema.json",
  "title": "Praxis Worker Record",
  "description": "Durable record for one planned or launched worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "worker_id",
    "run_id",
    "adapter",
    "worker_class",
    "launch_surface",
    "launch_reason",
    "permission_profile",
    "worktree_mode",
    "worktree_path",
    "session_id",
    "launch_record_path",
    "trace_path",
    "status"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "enum": ["claude", "codex"]
    },
    "worker_class": {
      "type": "string",
      "enum": ["interactive_orchestrator", "session_worker", "worktree_worker"]
    },
    "launch_surface": {
      "type": "string",
      "minLength": 1
    },
    "launch_reason": {
      "type": "string",
      "minLength": 1
    },
    "permission_profile": {
      "type": "string",
      "enum": ["planning", "design", "implementation", "review", "verification"]
    },
    "worktree_mode": {
      "type": "string",
      "enum": ["shared", "isolated"]
    },
    "worktree_path": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "session_id": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "launch_record_path": {
      "type": "string",
      "pattern": "^\\.praxis/runtime/launches/(?:codex|claude)/.*\\.json$"
    },
    "dispatch_id": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "worker_launch_path": {
      "anyOf": [
        { "type": "string", "pattern": "^\\.praxis/runtime/dispatches/.+/worker-launch\\.json$" },
        { "type": "null" }
      ]
    },
    "dispatch_record_path": {
      "anyOf": [
        { "type": "string", "pattern": "^\\.praxis/runtime/dispatches/.+/dispatch-record\\.json$" },
        { "type": "null" }
      ]
    },
    "context_manifest_path": {
      "anyOf": [
        { "type": "string", "pattern": "^\\.praxis/runtime/dispatches/.+/context-manifest\\.json$" },
        { "type": "null" }
      ]
    },
    "trace_path": {
      "type": "string",
      "pattern": "^\\.praxis/runtime/traces/.*\\.jsonl$"
    },
    "launcher_pid": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "mode",
        "worktree_path",
        "product_worktree_path",
        "review_independence_required",
        "product_worktree_mutation_allowed",
        "runtime_state_channel",
        "guardrail_reason_code",
        "guardrail_reason"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["shared", "isolated"]
        },
        "worktree_path": {
          "type": "string",
          "minLength": 1
        },
        "product_worktree_path": {
          "type": "string",
          "minLength": 1
        },
        "review_independence_required": {
          "type": "boolean"
        },
        "product_worktree_mutation_allowed": {
          "type": "boolean"
        },
        "runtime_state_channel": {
          "type": "string",
          "enum": ["direct_repo", "praxis_symlink"]
        },
        "guardrail_reason_code": {
          "type": "string",
          "minLength": 1
        },
        "guardrail_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "completed", "failed", "cancelled"]
    }
  }
}
