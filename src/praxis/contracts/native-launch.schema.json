{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/native-launch.schema.json",
  "title": "Praxis Native Launch Record",
  "description": "Durable machine-readable evidence that a native adapter launch path was used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recorded_at",
    "adapter",
    "kind",
    "session",
    "dispatch",
    "context",
    "harness"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "adapter": {
      "type": "string",
      "enum": ["codex", "claude"]
    },
    "kind": {
      "type": "string",
      "const": "session_start"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "cwd"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "resumable": {
          "type": "boolean"
        },
        "origin": {
          "type": "string",
          "enum": [
            "interactive_start",
            "interactive_resume",
            "headless_start",
            "headless_resume"
          ]
        },
        "provider_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "scope", "slice_id", "artifact_dir", "stage", "boundary_handoff_path"],
      "properties": {
        "workflow": {
          "type": "string",
          "enum": ["craft", "forge"]
        },
        "scope": {
          "type": "string",
          "enum": ["root", "feature", "slice"]
        },
        "slice_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "artifact_dir": {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        "stage": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "boundary_handoff_path": {
          "anyOf": [
            { "type": "string", "pattern": "^\\.praxis(?:/.*)?$" },
            { "type": "null" }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_context",
        "carry_forward_mode",
        "allowed_context_sources",
        "handoff_injected",
        "boundary_handoff_story_id",
        "boundary_handoff_next_story_id"
      ],
      "properties": {
        "fresh_context": {
          "type": "boolean"
        },
        "carry_forward_mode": {
          "type": "string",
          "const": "boundary_handoff_only"
        },
        "allowed_context_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["dispatch", "run_metadata", "boundary_handoff"]
          },
          "uniqueItems": true
        },
        "handoff_injected": {
          "type": "boolean"
        },
        "boundary_handoff_story_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "boundary_handoff_next_story_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "context_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary_handoff_fingerprint": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_class": {
          "type": "string",
          "enum": ["interactive_orchestrator", "session_worker", "worktree_worker"]
        },
        "launch_surface": {
          "type": "string",
          "minLength": 1
        },
        "permission_profile": {
          "type": "string",
          "enum": ["planning", "design", "implementation", "review", "verification"]
        },
        "worktree_mode": {
          "type": "string",
          "enum": ["shared", "isolated"]
        },
        "worktree_path": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "worker_signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "anyOf": [
            { "type": "string", "enum": ["prefer_resume_then_relaunch", "relaunch_only"] },
            { "type": "null" }
          ]
        },
        "previous_session_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "mode": {
          "anyOf": [
            { "type": "string", "enum": ["interactive", "headless"] },
            { "type": "null" }
          ]
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions_path",
        "project_config_path",
        "hooks_path",
        "agents_path",
        "launch_record_path",
        "compatibility"
      ],
      "properties": {
        "instructions_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
        },
        "project_config_path": {
          "anyOf": [
            { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$" },
            { "type": "null" }
          ]
        },
        "hooks_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
        },
        "agents_path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
        },
        "launch_record_path": {
          "type": "string",
          "pattern": "^\\.praxis/runtime/launches/(?:codex|claude)/.*\\.json$"
        },
        "trace_path": {
          "type": "string",
          "pattern": "^\\.praxis/runtime/traces/.*\\.jsonl$"
        },
        "compatibility": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["settings_path", "hooks_path", "subagents_path"],
              "properties": {
                "settings_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
                },
                "hooks_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
                },
                "subagents_path": {
                  "type": "string",
                  "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": ["worker", "resume"],
        "properties": {
          "session": {
            "required": ["id", "source", "cwd", "resumable"]
          },
          "worker": {
            "required": ["worker_id", "worker_class", "launch_surface", "permission_profile", "worktree_mode", "worktree_path"]
          },
          "resume": {
            "required": ["attempted", "outcome", "strategy", "previous_session_id"]
          },
          "harness": {
            "required": [
              "instructions_path",
              "project_config_path",
              "hooks_path",
              "agents_path",
              "launch_record_path",
              "trace_path",
              "compatibility"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "required": ["origin", "provider_locator"]
          },
          "context": {
            "required": ["context_fingerprint", "boundary_handoff_fingerprint"]
          },
          "worker": {
            "required": ["worker_signature"]
          },
          "resume": {
            "required": ["mode"]
          }
        }
      }
    }
  ]
}
