{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/src/praxis/contracts/eval-case.schema.json",
  "title": "Praxis Eval Case",
  "description": "Fixture used by the Praxis local eval pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "kind",
    "input",
    "expected"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "routing",
        "resume",
        "boundary_stop",
        "handoff_budget",
        "adapter_parity",
        "native_harness",
        "native_trace"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    },
    "expected": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
