{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/run.schema.json",
  "title": "Praxis Workflow Run",
  "description": "Canonical state for an active Praxis workflow run stored at .praxis/run.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow",
    "status",
    "entry_task",
    "mode",
    "execution",
    "current",
    "routing",
    "timestamps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [3, 4]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "$ref": "#/$defs/workflowName"
    },
    "status": {
      "$ref": "#/$defs/runStatus"
    },
    "entry_task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "$ref": "#/$defs/runMode"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["claude", "codex"]
        },
        "entrypoint": {
          "type": "string"
        }
      },
      "required": ["adapter"]
    },
    "execution": {
      "type": "object",
      "description": "Execution policy for advancing stories. Separate from workflow type and story-shape mode.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "autopilot"]
        },
        "fresh_context_per_story": {
          "type": "boolean"
        }
      },
      "required": ["mode"]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "manual_session_required": {
          "type": "boolean"
        },
        "last_transition_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "recovery_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "artifact_dir", "stage"],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scopeKind"
        },
        "slice_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "artifact_dir": {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        "stage": {
          "anyOf": [
            { "$ref": "#/$defs/stageName" },
            { "type": "null" }
          ]
        },
        "worker_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "session_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "slice"
              }
            }
          },
          "then": {
            "required": ["slice_id"],
            "properties": {
              "slice_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_action",
        "next_stage",
        "next_slice_id",
        "reason",
        "stop_reason_code",
        "boundary_handoff_path"
      ],
      "properties": {
        "next_action": {
          "$ref": "#/$defs/nextAction"
        },
        "next_stage": {
          "anyOf": [
            { "$ref": "#/$defs/stageName" },
            { "type": "null" }
          ]
        },
        "next_slice_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "reason": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "stop_reason_code": {
          "description": "Machine-readable reason why autopilot paused, blocked, or cancelled progression.",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "boundary_handoff_path": {
          "description": "Path to the unconsumed story-boundary handoff artifact that should seed the next slice-level clarifying-intent run.",
          "anyOf": [
            { "type": "string", "pattern": "^\\.praxis(?:/.*)?$" },
            { "type": "null" }
          ]
        },
        "pending_worker_action": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["resume_or_launch", "await_stage_result"]
            },
            { "type": "null" }
          ]
        },
        "resume_strategy": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["prefer_resume_then_relaunch", "relaunch_only"]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_max_turns": {
          "type": "integer"
        },
        "run_max_workers": {
          "type": "integer"
        },
        "soft_cost_usd": {
          "type": "number"
        },
        "hard_cost_usd": {
          "type": "number"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_permission_profile": {
          "type": "string",
          "enum": ["planning", "design", "implementation", "review", "verification"]
        },
        "require_fresh_review_worker": {
          "type": "boolean"
        }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending_user_decision": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "pending_review_gate": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 4
          }
        }
      },
      "then": {
        "required": [
          "run_id",
          "workflow_version",
          "runtime",
          "control",
          "budgets",
          "policy",
          "checkpoints"
        ],
        "properties": {
          "current": {
            "required": ["worker_id", "session_id"]
          },
          "routing": {
            "required": ["pending_worker_action", "resume_strategy"]
          },
          "execution": {
            "required": ["mode", "fresh_context_per_story"]
          },
          "control": {
            "required": ["owner", "manual_session_required", "last_transition_id", "recovery_status"]
          },
          "budgets": {
            "required": ["run_max_turns", "run_max_workers", "soft_cost_usd", "hard_cost_usd"]
          },
          "policy": {
            "required": [
              "default_permission_profile",
              "require_fresh_review_worker"
            ]
          },
          "checkpoints": {
            "required": ["pending_user_decision", "pending_review_gate"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "single_story"
          }
        }
      },
      "then": {
        "properties": {
          "current": {
            "properties": {
              "scope": {
                "enum": ["root", "feature"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "workflowName": {
      "type": "string",
      "enum": ["craft", "forge"]
    },
    "runStatus": {
      "type": "string",
      "enum": ["running", "waiting_for_user", "completed", "cancelled", "failed"]
    },
    "runMode": {
      "type": "string",
      "enum": ["single_story", "multi_slice"]
    },
    "scopeKind": {
      "type": "string",
      "enum": ["root", "feature", "slice"]
    },
    "stageName": {
      "type": "string",
      "enum": [
        "clarifying-intent",
        "slicing-stories",
        "sketching-design",
        "driving-tdd",
        "rapid-implementing",
        "code-reviewing",
        "code-improving",
        "verifying-and-adapting"
      ]
    },
    "nextAction": {
      "type": "string",
      "enum": ["run_stage", "confirm_then_run", "ask_user", "finish", "idle"]
    }
  }
}
