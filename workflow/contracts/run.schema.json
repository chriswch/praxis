{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/run.schema.json",
  "title": "Praxis Workflow Run",
  "description": "Canonical state for a Praxis v2 workflow run stored at .praxis/run.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflow",
    "status",
    "entry_task",
    "mode",
    "current",
    "routing",
    "timestamps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "workflow": {
      "$ref": "#/$defs/workflowName"
    },
    "status": {
      "$ref": "#/$defs/runStatus"
    },
    "entry_task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "$ref": "#/$defs/runMode"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ]
        },
        "entrypoint": {
          "type": "string"
        }
      },
      "required": [
        "adapter"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "autopilot"
          ]
        },
        "fresh_context_per_story": {
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ]
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "artifact_dir",
        "stage"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scopeKind"
        },
        "slice_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_dir": {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/stageName"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "slice"
              }
            }
          },
          "then": {
            "required": [
              "slice_id"
            ],
            "properties": {
              "slice_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "active",
        "completed"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "active": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_action",
        "next_stage"
      ],
      "properties": {
        "next_action": {
          "$ref": "#/$defs/nextAction"
        },
        "next_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/stageName"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_slice_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "boundary_handoff_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\.praxis(?:/.*)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "multi_slice"
          }
        }
      },
      "then": {
        "required": [
          "slices"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "single_story"
          }
        }
      },
      "then": {
        "properties": {
          "current": {
            "properties": {
              "scope": {
                "enum": [
                  "root",
                  "feature"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "workflowName": {
      "type": "string",
      "enum": [
        "craft",
        "forge"
      ]
    },
    "runStatus": {
      "type": "string",
      "enum": [
        "running",
        "waiting_for_user",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "runMode": {
      "type": "string",
      "enum": [
        "single_story",
        "multi_slice"
      ]
    },
    "scopeKind": {
      "type": "string",
      "enum": [
        "root",
        "feature",
        "slice"
      ]
    },
    "stageName": {
      "type": "string",
      "enum": [
        "clarifying-intent",
        "slicing-stories",
        "sketching-design",
        "driving-tdd",
        "rapid-implementing",
        "code-reviewing",
        "code-improving",
        "verifying-and-adapting"
      ]
    },
    "nextAction": {
      "type": "string",
      "enum": [
        "run_stage",
        "ask_user",
        "confirm_then_run",
        "run_slice",
        "finish",
        "idle"
      ]
    }
  }
}
