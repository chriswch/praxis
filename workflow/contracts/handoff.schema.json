{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/handoff.schema.json",
  "title": "Praxis Story Boundary Handoff",
  "description": "Canonical cross-story handoff artifact stored at .praxis/slices/<slice-id>/handoff.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "story_id",
    "next_story_id",
    "summary",
    "carry_forward_context",
    "changed_paths",
    "commit_meta",
    "generated_at",
    "policy",
    "metrics",
    "compaction",
    "validation"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "next_story_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "carry_forward_context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit_meta": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_summary_chars",
        "max_carry_forward_items",
        "max_changed_paths",
        "max_serialized_bytes"
      ],
      "properties": {
        "max_summary_chars": {
          "type": "integer"
        },
        "max_carry_forward_items": {
          "type": "integer"
        },
        "max_changed_paths": {
          "type": "integer"
        },
        "max_serialized_bytes": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_chars",
        "carry_forward_items",
        "changed_paths",
        "serialized_bytes"
      ],
      "properties": {
        "summary_chars": {
          "type": "integer"
        },
        "carry_forward_items": {
          "type": "integer"
        },
        "changed_paths": {
          "type": "integer"
        },
        "serialized_bytes": {
          "type": "integer"
        }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "summary_truncated",
        "carry_forward_items_dropped",
        "changed_paths_dropped"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "summary_truncated": {
          "type": "boolean"
        },
        "carry_forward_items_dropped": {
          "type": "integer"
        },
        "changed_paths_dropped": {
          "type": "integer"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid",
        "within_budget"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "within_budget": {
          "type": "boolean"
        }
      }
    }
  }
}
