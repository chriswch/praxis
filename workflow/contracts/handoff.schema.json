{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/handoff.schema.json",
  "title": "Praxis Story Boundary Handoff",
  "description": "Canonical cross-story handoff artifact stored at .praxis/slices/<slice-id>/handoff.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "story_id",
    "next_story_id",
    "summary",
    "carry_forward_context",
    "changed_paths",
    "commit_meta",
    "generated_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "next_story_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "carry_forward_context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit_meta": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
