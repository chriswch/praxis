{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/stage-result.schema.json",
  "title": "Praxis Stage Result",
  "description": "Canonical result for a Praxis stage run stored at {artifact-dir}/results/<stage>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "artifact_dir",
    "status",
    "summary_path",
    "artifacts_written",
    "route",
    "data",
    "needs_user_input",
    "needs_confirmation"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "stage": {
      "$ref": "#/$defs/stageName"
    },
    "artifact_dir": {
      "type": "string",
      "pattern": "^\\.praxis(?:/.*)?$"
    },
    "status": {
      "$ref": "#/$defs/resultStatus"
    },
    "summary_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\.praxis(?:/.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts_written": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.praxis(?:/.*)?$"
      },
      "uniqueItems": true
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "next_stage",
        "next_slice_id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/routeKind"
        },
        "next_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/stageName"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_slice_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Stage-specific structured details. outcome_code should be the main stage-specific routing signal.",
      "additionalProperties": true,
      "properties": {
        "outcome_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "outcome_code"
      ]
    },
    "needs_user_input": {
      "type": "boolean"
    },
    "needs_confirmation": {
      "type": "boolean"
    }
  },
  "$defs": {
    "stageName": {
      "type": "string",
      "enum": [
        "clarifying-intent",
        "slicing-stories",
        "sketching-design",
        "driving-tdd",
        "rapid-implementing",
        "code-reviewing",
        "code-improving",
        "verifying-and-adapting"
      ]
    },
    "routeKind": {
      "type": "string",
      "enum": [
        "proceed",
        "ask_user",
        "done",
        "next_slice",
        "rework",
        "escalate"
      ]
    },
    "resultStatus": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "skipped"
      ]
    }
  }
}
