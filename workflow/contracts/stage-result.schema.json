{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/stage-result.schema.json",
  "title": "Praxis Stage Result",
  "description": "Canonical result for a Praxis stage run stored at {artifact-dir}/results/<stage>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "artifact_dir",
    "status",
    "summary_path",
    "artifacts_written",
    "route",
    "data",
    "needs_user_input",
    "needs_confirmation"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [2, 3]
    },
    "run_id": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "stage": {
      "$ref": "#/$defs/stageName"
    },
    "artifact_dir": {
      "type": "string",
      "pattern": "^\\.praxis(?:/.*)?$"
    },
    "status": {
      "$ref": "#/$defs/resultStatus"
    },
    "summary_path": {
      "anyOf": [
        { "type": "string", "pattern": "^\\.praxis(?:/.*)?$" },
        { "type": "null" }
      ]
    },
    "artifacts_written": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.praxis(?:/.*)?$"
      },
      "uniqueItems": true
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "next_stage", "next_slice_id"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/routeKind"
        },
        "next_stage": {
          "description": "Stage skills may leave this null; shared workflow orchestration resolves the canonical next stage from workflow plus outcome.",
          "anyOf": [
            { "$ref": "#/$defs/stageName" },
            { "type": "null" }
          ]
        },
        "next_slice_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "reason": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Stage-specific structured details. outcome_code should be the main stage-specific routing signal.",
      "additionalProperties": true,
      "properties": {
        "outcome_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["outcome_code"]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "adapter": {
          "anyOf": [
            { "type": "string", "enum": ["claude", "codex"] },
            { "type": "null" }
          ]
        },
        "session_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "worker_class": {
          "type": "string",
          "enum": ["interactive_orchestrator", "session_worker"]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permission_profile": {
          "type": "string",
          "enum": ["planning", "design", "implementation", "review", "verification"]
        },
        "worktree_mode": {
          "type": "string",
          "enum": ["shared", "isolated"]
        },
        "fresh_context": {
          "type": "boolean"
        },
        "resumed": {
          "type": "boolean"
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.praxis(?:/.*)?$"
      },
      "uniqueItems": true
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.praxis(?:/.*)?$"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_run": {
          "type": "boolean"
        },
        "diff_reviewed": {
          "type": "boolean"
        }
      }
    },
    "handoff": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "needs_user_input": {
      "type": "boolean"
    },
    "needs_confirmation": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "run_id",
          "worker",
          "execution",
          "input_artifacts",
          "output_artifacts",
          "verification",
          "handoff"
        ],
        "properties": {
          "worker": {
            "required": ["worker_id", "adapter", "session_id", "worker_class"]
          },
          "execution": {
            "required": ["permission_profile", "worktree_mode", "fresh_context", "resumed"]
          },
          "verification": {
            "required": ["tests_run", "diff_reviewed"]
          }
        }
      }
    }
  ],
  "$defs": {
    "stageName": {
      "type": "string",
      "enum": [
        "clarifying-intent",
        "slicing-stories",
        "sketching-design",
        "driving-tdd",
        "rapid-implementing",
        "code-reviewing",
        "code-improving",
        "verifying-and-adapting"
      ]
    },
    "routeKind": {
      "type": "string",
      "enum": ["proceed", "ask_user", "done", "next_slice", "rework", "escalate"]
    },
    "resultStatus": {
      "type": "string",
      "enum": ["completed", "blocked", "failed", "skipped"]
    }
  }
}
