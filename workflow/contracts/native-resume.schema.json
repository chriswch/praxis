{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/native-resume.schema.json",
  "title": "Praxis Native Resume Record",
  "description": "Durable machine-readable evidence that a provider-native resume path was requested and how Praxis resolved it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recorded_at",
    "adapter",
    "worker_id",
    "run_id",
    "attempt_kind",
    "requested_session_id",
    "resolved_session_id",
    "resume_mode",
    "prompt_injected",
    "safety_checks",
    "outcome",
    "trace_path",
    "session_record_path",
    "provider_metadata",
    "reason_code",
    "reason"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "adapter": {
      "type": "string",
      "enum": ["claude", "codex"]
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_kind": {
      "type": "string",
      "const": "provider_resume"
    },
    "requested_session_id": {
      "type": "string",
      "minLength": 1
    },
    "resolved_session_id": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "resume_mode": {
      "type": "string",
      "enum": ["interactive", "headless"]
    },
    "prompt_injected": {
      "type": "boolean"
    },
    "safety_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "reason_code", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "reason_code": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "reason": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "trace_path": {
      "type": "string",
      "pattern": "^\\.praxis/runtime/traces/.*\\.jsonl$"
    },
    "session_record_path": {
      "anyOf": [
        { "type": "string", "pattern": "^\\.praxis/runtime/sessions/(?:codex|claude)/.*\\.json$" },
        { "type": "null" }
      ]
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
