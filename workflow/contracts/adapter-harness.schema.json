{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chriswch/praxis/workflow/contracts/adapter-harness.schema.json",
  "title": "Praxis Adapter Harness Config",
  "description": "Repo-scoped harness configuration for one runtime adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "adapter",
    "instructions_path",
    "project_config_path",
    "hooks_path",
    "agents_path",
    "worker_launch_command",
    "extension_points",
    "compatibility"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "adapter": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "instructions_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
    },
    "project_config_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hooks_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
    },
    "agents_path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
    },
    "worker_launch_command": {
      "type": "string",
      "minLength": 1
    },
    "extension_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_config_path",
        "resources_path",
        "tool_overrides_path",
        "notes_path"
      ],
      "properties": {
        "mcp_config_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_overrides_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "compatibility": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settings_path",
            "hooks_path",
            "subagents_path"
          ],
          "properties": {
            "settings_path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            "hooks_path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            },
            "subagents_path": {
              "type": "string",
              "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "codex"
          }
        }
      },
      "then": {
        "properties": {
          "project_config_path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:\\\\)[^\\n]+$"
          },
          "compatibility": {
            "type": "object"
          }
        }
      }
    }
  ]
}
